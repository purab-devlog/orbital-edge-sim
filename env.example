# Sarvam Orbital Edge Simulator — Environment Config
# Copy this to .env and fill in your values.
# .env is gitignored — never commit it.

# Sarvam API key (optional — enables Bulbul TTS)
# Get yours at: https://dashboard.sarvam.ai
# If not set, the simulator falls back to browser Web Speech API.
SARVAM_API_KEY=

# Simulation tick speed (ms per tick, default 300ms = 100x real-time)
# Lower = faster demo.  Minimum recommended: 150ms.
TICK_INTERVAL_MS=300
